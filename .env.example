# Application Configuration
APP_NAME=Dynamic Multi Tenant API
APP_ENV=development
DEBUG=true

# Database Connection (Async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/tenant_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Authentication and Cryptography
JWT_SECRET_KEY=replace-with-a-secure-secret-minimum-32-chars-long
JWT_ALGORITHM=HS256
JWT_ISSUER=dynamic-tenant-api
JWT_AUDIENCE=tenant-users
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Administrative Access Key
ADMIN_API_KEY=admin-secret-key-change-in-production

# Dynamic Tenant Cache Settings
TENANT_CACHE_MAX_SIZE=1000
TENANT_CACHE_TTL_SECONDS=3600

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

